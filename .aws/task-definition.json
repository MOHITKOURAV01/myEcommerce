{
    "family": "booksmart-task",
    "networkMode": "awsvpc",
    "executionRoleArn": "arn:aws:iam::988311616029:role/LabRole",
    "taskRoleArn": "arn:aws:iam::988311616029:role/LabRole",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "512",
    "memory": "1024",
    "containerDefinitions": [
        {
            "name": "booksmart-server-container",
            "image": "988311616029.dkr.ecr.us-east-1.amazonaws.com/booksmart-server:latest",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 5000,
                    "hostPort": 5000,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "NODE_ENV",
                    "value": "production"
                },
                {
                    "name": "PORT",
                    "value": "5000"
                },
                {
                    "name": "MONGO_URI",
                    "value": "mongodb://localhost:27017/booksmart"
                }
            ]
        },
        {
            "name": "booksmart-client-container",
            "image": "988311616029.dkr.ecr.us-east-1.amazonaws.com/booksmart-client:latest",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "VITE_API_URL",
                    "value": "/api"
                }
            ]
        }
    ]
}
