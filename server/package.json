{
  "name": "booksmart-server",
  "version": "2.0.0",
  "description": "BookSmart — Smart Book Discovery Platform API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "cross-env NODE_ENV=test jest tests/integration --runInBand",
    "lint": "eslint . --ext .js",
    "seed": "node data/seedData.js"
  },
  "keywords": ["booksmart", "ecommerce", "bookshop"],
  "author": "Mohit Kourav",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.1.6",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.3",
    "redis": "^5.0.1",
    "slugify": "^1.6.6",
    "stripe": "^18.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "jest": "^30.0.2",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"],
    "coverageDirectory": "coverage",
    "testTimeout": 30000
  }
}
